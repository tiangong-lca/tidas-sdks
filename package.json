{
  "name": "tidas-sdk",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "build:typescript": "pnpm --filter @tiangong-lca/tidas-sdk build",
    "test:typescript": "pnpm --filter @tiangong-lca/tidas-sdk test",
    "verify:typescript": "./scripts/ci/verify-typescript-package.sh",
    "verify:python": "./scripts/ci/verify-python-package.sh",
    "release:prepare:patch:typescript": "pnpm --filter @tiangong-lca/tidas-sdk release:prepare:patch",
    "release:prepare:minor:typescript": "pnpm --filter @tiangong-lca/tidas-sdk release:prepare:minor",
    "release:prepare:major:typescript": "pnpm --filter @tiangong-lca/tidas-sdk release:prepare:major"
  }
}
