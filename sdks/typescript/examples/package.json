{
  "name": "tidas-sdk-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Examples for @tiangong-lca/tidas-sdk",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test-imports": "tsx --tsconfig tsconfig.json test-imports.ts",
    "run-contact-draft": "tsx --tsconfig tsconfig.json 01-basic-usage/contact-draft.ts",
    "run-xml-roundtrip": "tsx --tsconfig tsconfig.json 02-xml-roundtrip/xml-roundtrip.ts",
    "check": "npm run typecheck && npm run test-imports && npm run run-contact-draft && npm run run-xml-roundtrip"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tiangong-lca/tidas-sdk": "file:.."
  }
}
