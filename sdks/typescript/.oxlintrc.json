{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off",
    "nursery": "off",
    "pedantic": "off",
    "perf": "off",
    "restriction": "off",
    "style": "off",
    "suspicious": "off"
  },
  "env": {
    "es2022": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    "examples/**",
    "node_modules/**",
    "src/runtime-assets/**"
  ],
  "options": {
    "respectEslintDisableDirectives": true,
    "typeAware": true
  },
  "plugins": ["typescript"],
  "rules": {
    "no-useless-escape": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-deprecated": "error"
  }
}
